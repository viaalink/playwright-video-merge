{
  "name": "@viaalink/playwright-video-merge",
  "version": "0.2.1",
  "description": "Merge Playwright test result videos into a single demo reel with test name overlays",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "playwright-video-merge": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p ."
  },
  "keywords": [
    "playwright",
    "video",
    "merge",
    "concat",
    "ffmpeg",
    "demo",
    "e2e",
    "test",
    "recording",
    "demo-reel",
    "viaalink"
  ],
  "author": "Viaalink <info@viaalink.com> (https://viaalink.com)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viaalink/playwright-video-merge.git"
  },
  "bugs": {
    "url": "https://github.com/viaalink/playwright-video-merge/issues"
  },
  "homepage": "https://viaalink.com",
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
